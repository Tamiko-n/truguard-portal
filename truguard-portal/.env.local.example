# Google Sheets — create a service account in Google Cloud Console,
# share your Sheet with the service account email (Editor access),
# paste the credentials here.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# The spreadsheet ID from the Google Sheets URL
SHEET_ID=1hAqdor0_DBcZEHdDa_VBwaws5LRhEl4IgOGeItcQ9Rc

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Internal API key for n8n → portal webhooks
INTERNAL_API_KEY=change-this-to-a-long-random-string
